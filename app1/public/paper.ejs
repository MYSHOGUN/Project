<style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;700&display=swap');

    /* จัด Layout หลักให้กึ่งกลางหน้าจอ */
    .platform-wrapper {
        font-family: 'Prompt', sans-serif !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        min-height: 85vh !important;
        padding: 2rem 0 !important;
    }

    .platform-container {
        width: 100% !important;
        max-width: 1150px !important;
    }

    .paper-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(100%, 1fr)) !important;
        gap: 2rem !important;
        width: 100% !important;
    }

    .paper-card {
        border-radius: 20px !important;
        border: none !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
        background: #ffffff !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05) !important;
    }

    .paper-card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 15px 35px rgba(78, 115, 223, 0.1) !important;
    }

    .file-scroll-area {
        height: 180px !important;
        min-height: 180px !important;
        background: #fdfdfd !important;
        border: 1px solid #edf0f5 !important;
        border-radius: 12px !important;
        overflow-y: auto;
    }

    .custom-drop-zone {
        border: 2px dashed #4e73df !important;
        background: #f8f9fc !important;
        border-radius: 15px !important;
        min-height: 180px !important;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .custom-drop-zone:hover { background: #eff2f9 !important; }

    .custom-check-container {
        display: inline-flex;
        align-items: center;
        background: #fff;
        padding: 8px 18px;
        border-radius: 25px;
        border: 2px solid #e3e6f0;
        cursor: pointer;
        transition: all 0.2s;
    }

    /* ✅ จัดการเนื้อหาภายใน Card ด้วย Grid */
    .paper-content-grid {
        display: grid !important;
        /* จอใหญ่แบ่ง 2 คอลัมน์เท่ากัน, จอเล็ก (ต่ำกว่า 768px) เหลือ 1 คอลัมน์ */
        grid-template-columns: 1fr 1fr !important;
        gap: 1.5rem !important;
        width: 100% !important;
    }

    @media (max-width: 768px) {
        .paper-content-grid {
            grid-template-columns: 1fr !important; /* จอเล็กซ้อนบรรทัดกัน */
        }

        /* ปรับ header ของ card ให้เป็นแนวตั้งตอนจอเล็ก */
        .paper-card .card-body .d-flex.justify-content-between {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 1rem !important;
        }

        /* ปรับปุ่มและ checkbox ให้ชิดซ้ายตอนจอเล็ก */
        .paper-card .card-body .d-flex.align-items-center {
            width: 100% !important;
            justify-content: flex-start !important;
        }

        /* ปรับ header หลักให้ responsive */
        .platform-container h1 {
            font-size: 1.5rem !important;
        }

        /* ปรับ voting form สำหรับอาจารย์ */
        .paper-card .d-flex.justify-content-center {
            flex-direction: column !important;
            gap: 0.8rem !important;
            align-items: flex-start !important;
        }

        /* ปรับ textarea ให้เต็มความกว้าง */
        .paper-card textarea {
            max-width: 100% !important;
        }

        /* ปรับ custom-check-container ให้ responsive */
        .custom-check-container {
            padding: 6px 12px !important;
            flex-wrap: wrap !important;
        }

        /* ปรับ accordion header ให้ responsive */
        .task-grade-header, .task-doc-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 0.5rem !important;
        }

        .task-grade-header .d-flex, .task-doc-header .d-flex {
            width: 100% !important;
            justify-content: space-between !important;
        }

        /* ปรับ file scroll area และ drop zone ให้ responsive */
        .file-scroll-area {
            height: 150px !important;
            min-height: 150px !important;
        }

        .custom-drop-zone {
            min-height: 150px !important;
        }

        /* ปรับ button ให้ responsive */
        .paper-card .btn {
            font-size: 0.875rem !important;
            padding: 0.375rem 0.75rem !important;
        }

        /* ปรับ radio label ให้ responsive */
        .custom-control-label {
            font-size: 0.875rem !important;
        }

        /* ปรับการแสดงรายการไฟล์ให้ responsive */
        .file-scroll-area .d-flex.justify-content-between {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 0.5rem !important;
        }

        .file-scroll-area .d-flex.justify-content-between .d-flex {
            width: 100% !important;
            justify-content: flex-start !important;
        }

        .file-scroll-area .text-truncate {
            max-width: 100% !important;
        }

        .file-scroll-area .btn-circle {
            margin-left: 0 !important;
            margin-right: 0.5rem !important;
        }
    }

    /* ปรับให้ Drop Zone มีความสูงเต็มพื้นที่คอลัมน์ */
    .custom-drop-zone {
        height: 100% !important;
        min-height: 180px !important;
    }

    .file-scroll-area {
        width: 100% !important; /* ป้องกันการเบียดซ้าย */
    }

    /* ✅ ทำให้ลูกศรหมุนเวลาพับ/กาง Accordion */
    [data-toggle="collapse"] i.fa-chevron-down {
        transition: transform 0.3s ease;
    }
    [data-toggle="collapse"].collapsed i.fa-chevron-down {
        transform: rotate(-90deg);
    }
</style>

<input type="hidden" id="raw-groups-data" value='<%- JSON.stringify(groups) %>'>
<input type="hidden" id="raw-result-data" value='<%- JSON.stringify(result) %>'>
<input type="hidden" id="raw-paperFile-data" value='<%- JSON.stringify(paperFile) %>'>

<div class="container-fluid">
    <div class="platform-wrapper">
        <div class="platform-container mb-3 text-center text-md-left">
            <h1 class="font-weight-bold text-gray-800" style="font-size: 2.2rem;">
                <i class="fas fa-file-export mr-3 text-primary"></i>แพลตฟอร์มส่งเอกสาร
            </h1>
            <p class="text-muted">จัดการส่งเอกสาร ตรวจสอบความพร้อม และบันทึกผลการพิจารณาโครงงาน</p>
        </div>

        <div class="platform-container">
            <div id="paper-platform-container">
                <div class="text-center py-5" style="width: 100%;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">กำลังโหลดรายการส่งเอกสาร...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const groupsData = JSON.parse(document.getElementById('raw-groups-data')?.value || "[]");
    const resultData = JSON.parse(document.getElementById('raw-result-data')?.value || "[]");
    const paperFileData = JSON.parse(document.getElementById('raw-paperFile-data')?.value || "[]");

    const currentUsername = "<%= user.username %>";
    const currentName = "<%= user.name %>";
    const currentRole = "<%= user.role %>";

    async function loadPaperPlatforms() {
        try {
            const [res, usersRes] = await Promise.all([
                fetch('/api/getMyPapers'),
                fetch('/api/getUsers')
            ]);
            const papers = await res.json();
            const usersData = await usersRes.json();
            const allUsers = usersData.users || [];
            const container = document.getElementById('paper-platform-container');

            // ฟังก์ชันช่วยตรวจสอบว่าเป็นเอกสารชุด "สำหรับลงคะแนนสอบ" หรือไม่
            const isExamPaper = (mention) => mention && (mention.includes("จะมีการจัดสอบ") || mention === "วันสอบ");

            let visiblePapers = papers.filter(paper => {
                // ถ้านักศึกษา: จะเห็นเฉพาะรายการที่ไม่ใช่แค่ "ประกาศวันสอบ" เฉยๆ (ต้องมีที่ให้ส่งไฟล์)
                if (currentRole === "user") {
                    return !isExamPaper(paper.mention);
                }
                // ถ้าอาจารย์/แอดมิน: เห็นทุกรายการ (เพื่อบันทึกผลสอบ)
                return true; 
            });
            console.log(`Checking: ${visiblePapers.length} paper ${papers.length}`);
            // 2. ตรวจสอบว่าหลังจากกรองแล้ว เหลือสิ่งที่ต้องแสดงไหม
            if (!papers || papers.length === 0 || visiblePapers.length === 0) {
                container.innerHTML = `
                <div class="card shadow-sm border-0 text-center py-5" style="border-radius: 15px; width: 100%;">
                    <div class="card-body">
                        <i class="fas fa-file-alt fa-4x text-gray-200 mb-3"></i>
                        <h4 class="text-gray-500">ไม่มีรายการส่งเอกสารในขณะนี้</h4>
                    </div>
                </div>`;
                return;
            }

            // ถ้ามีรายการเหลืออยู่ ให้ล้าง Loading เดิมออกก่อนเริ่มสร้าง Card
            container.innerHTML = "";
            let teacherCards = "";
            let studentCards = "";
            let teacherCount = 0;
            let studentCount = 0;
            
            const getUserFullName = (username) => {
                const u = allUsers.find(user => user.username === username);
                return u ? `${u.title && u.title !== 'รอเพิ่มข้อมูล' ? u.title + ' ' : ''}${u.name} ${u.lastname}`.trim() : username;
            };

            visiblePapers.forEach(paper => {
                
                const paperId = paper._id;
                const targetGroup = groupsData.find(g => g._id === paper.groupId);
                // ✅ FIX 2: ตรวจสอบว่าส่งไฟล์แล้วหรือยังให้แม่นยำขึ้น
                const hasSubmittedFiles = paperFileData.some(f => f.paperId === paperId);
                
                // ✅ FIX 1: ตรวจสอบกรรมการโดยใช้ Username แบบแยกคำ ป้องกันชื่อคล้ายกัน (เช่น user1 กับ user10)
                const checkCommittee = (field, username) => {
                    if (!field) return false;
                    return String(field).split(',').map(s => s.trim().replace(" (Pending)", "")).includes(username);
                };

                const isCommittee = checkCommittee(paper.director, currentUsername) ||
                                    checkCommittee(paper.greatDirector, currentUsername) ||
                                    checkCommittee(paper.advisor, currentUsername);
                
                if (!targetGroup) return '';

                const groupName = targetGroup.projectName;
                const isUserInGroup = [targetGroup.member1, targetGroup.member2, targetGroup.advisor].includes(currentUsername);
                
                // ✅ ปรับแก้ Logic วันที่ให้เทียบเฉพาะ วัน/เดือน/ปี
                const today = new Date();
                today.setHours(0,0,0,0);
                const paperDate = new Date(paper.date);
                paperDate.setHours(0,0,0,0);

                const exactNow = new Date();
                const examPaper = papers.find(p => p.groupId === paper.groupId && p.passTimes === paper.passTimes && isExamPaper(p.mention));
                const isExamPassed = examPaper && exactNow.getTime() > new Date(examPaper.date).getTime();

                // ✅ FIX 1.1: ทำให้ Logic การเช็คว่าโหวตไปแล้วหรือยัง อ่านง่ายขึ้น
                const targetResultForCurrentPass = resultData.find(r => r.groupId === paper.groupId && r.passTimes === paper.passTimes);
                const hasVoted = targetResultForCurrentPass ? (targetResultForCurrentPass.pass.includes(currentUsername) || targetResultForCurrentPass.fail.includes(currentUsername)) : false;

                const passTime = (paper.passTimes || 0);

                const test = paperDate.getTime() <= today.getTime();

                let text;

                const testText = passTime === 0 ? "ส่งเอกสารก่อนสอบนำเสนอหัวข้อปริญญานิพนธ์" : "ส่งเอกสารก่อนสอบป้องกันปริญญานิพนธ์" ;

                if (paper.mention && paper.mention.includes("โปรดส่งเอกสาร")){
                    text = "โปรดส่งเอกสารภายในวันที่ "+paperDate.toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric' });
                } else if (paper.mention && paper.mention.includes("แก้ไข")){
                    text = paper.mention + " ภายในวันที่ "+paperDate.toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric' });
                } else if (isExamPaper(paper.mention)){
                    text = paper.mention
                } else if (paperDate.getFullYear() === 2099) {
                    text = "สามารถส่งเอกสารได้ตลอดเวลา";
                }


                // ส่วนที่ 1: สำหรับอาจารย์ส่งผลสอบ
                if ((isCommittee || currentRole === "admin") && isExamPaper(paper.mention)) {

                    let votingFormHtml = '';
                    if (isCommittee && paperDate.getTime() <= today.getTime() && !hasVoted) {
                        votingFormHtml = `
                            <div class="d-flex justify-content-center mb-3 mt-2" style="gap: 20px;">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="pass-${paperId}" name="choice-${paperId}" value="ผ่าน" class="custom-control-input" onchange="showComment('${paperId}')">
                                    <label class="custom-control-label font-weight-bold text-success" for="pass-${paperId}">ผ่าน</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="fail-${paperId}" name="choice-${paperId}" value="ไม่ผ่าน" class="custom-control-input" onchange="showComment('${paperId}')">
                                    <label class="custom-control-label font-weight-bold text-danger" for="fail-${paperId}">ไม่ผ่าน</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="fix-${paperId}" name="choice-${paperId}" value="แก้ไข" class="custom-control-input" onchange="showComment('${paperId}')">
                                    <label class="custom-control-label font-weight-bold text-warning" for="fix-${paperId}">แก้ไข</label>
                                </div>
                            </div>
                            <textarea class="form-control mb-3 d-none mx-auto shadow-sm" id="comment-${paperId}" rows="2" style="max-width: 500px; border-radius: 12px;" placeholder="ระบุสิ่งที่ต้องการให้แก้ไข (นักศึกษาจะเห็นข้อความนี้)..."></textarea>
                            <button class="btn btn-primary px-5 shadow-sm rounded-pill font-weight-bold" onclick="submitResult('${paperId}')"><i class="fas fa-paper-plane mr-2"></i> ยืนยันส่งผลการสอบ</button>
                        `;
                    } else if (hasVoted) {
                        votingFormHtml = `
                            <div class="alert alert-success d-inline-block px-4 py-2 rounded-pill mb-0 shadow-sm">
                                <i class="fas fa-check-circle mr-2"></i> คุณได้ลงคะแนนเรียบร้อยแล้ว
                            </div>
                        `;
                    } else if (paperDate.getTime() > today.getTime()) {
                        votingFormHtml = `
                            <div class="alert alert-warning d-inline-block px-4 py-2 rounded-pill mb-0 shadow-sm">
                                <i class="fas fa-clock mr-2"></i> ยังไม่ถึงกำหนดเวลาสอบ
                            </div>
                        `;
                    } else if (!isCommittee && currentRole === "admin") {
                        votingFormHtml = `
                            <div class="alert alert-secondary d-inline-block px-4 py-2 rounded-pill mb-0 shadow-sm">
                                <i class="fas fa-user-shield mr-2"></i> มุมมองผู้ดูแลระบบ (Admin)
                            </div>
                        `;
                    }

                    teacherCount++;
                    teacherCards += `
                    <div class="card paper-card shadow mb-4 border-left-primary" style="grid-column: 1 / -1;">
                        <div class="card-body p-4 text-center">
                            <h5 class="font-weight-bold text-primary mb-3"><i class="fas fa-chalkboard-teacher mr-2"></i>บันทึกผลการสอบ: ${groupName}</h5>
                            ${votingFormHtml}
                        </div>
                    </div>`;
                }

                // ส่วนที่ 2: Card หลัก (ส่งไฟล์และ Checkbox อาจารย์)
                if ((isUserInGroup || currentRole === "admin") && !isExamPaper(paper.mention)) {
                    studentCount++;
                    // แก้ไขโครงสร้างในส่วน cardHtml (จุดที่ส่งไฟล์) ให้เป็นตามนี้ครับ
                // เปลี่ยนโครงสร้างภายใน cardHtml ช่วงที่มีการส่งไฟล์
                studentCards += `
                <div class="card paper-card shadow-sm border-left-${paper.isSubmitted ? 'success' : 'warning'} mb-4">
                    <div class="card-body p-4">
                        
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">${text || paper.mention}</div>
                                <h5 class="font-weight-bold text-gray-800 mb-0">${groupName} ${testText}</h5>
                            </div>
                            
                            <div class="d-flex align-items-center" style="gap: 10px;">
                                <a href="/api/generate-pdf/${targetGroup._id}" target="_blank" class="btn btn-sm btn-outline-danger shadow-sm px-3 rounded-pill">
                                    <i class="fas fa-file-pdf mr-2"></i>ดาวน์โหลดแบบฟอร์ม
                                </a>

                                ${((currentRole === 'teacher' || currentRole === 'admin') && (!paper.mention || !paper.mention.includes("แก้ไข"))) ? `
                                    <div class="custom-check-container mb-0 px-3 py-1">
                                        <div class="custom-control custom-radio custom-control-inline mb-0 mr-3">
                                            <input type="radio" id="ready-${paperId}" name="status-${paperId}" class="custom-control-input"
                                                onchange="updateReadyStatus(true, '${targetGroup._id}', '${paperId}', ${paperDate.getTime()})"
                                                ${targetGroup.status.includes('พร้อมสอบ') ? 'checked' : ''}
                                            ${!hasSubmittedFiles ? 'disabled' : ''}>
                                            <label class="custom-control-label small font-weight-bold text-success" style="cursor: pointer; padding-top: 2px;" for="ready-${paperId}">พร้อมสอบ</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline mb-0 mr-0">
                                            <input type="radio" id="notready-${paperId}" name="status-${paperId}" class="custom-control-input"
                                                onchange="updateReadyStatus(false, '${targetGroup._id}', '${paperId}', ${paperDate.getTime()})"
                                                ${(targetGroup.status.includes('ไม่พร้อม') || targetGroup.status.includes('แก้ไข')) ? 'checked' : ''}
                                            ${!hasSubmittedFiles ? 'disabled' : ''}>
                                            <label class="custom-control-label small font-weight-bold text-danger" style="cursor: pointer; padding-top: 2px;" for="notready-${paperId}">ไม่พร้อมสอบ</label>
                                        </div>
                                    ${(!hasSubmittedFiles) ? `
                                        <span id="status-text-${paperId}" class="small font-weight-bold ml-3 border-left pl-3 text-primary">
                                            ยังไม่ส่งเอกสาร
                                            </span>
                                        ` : ''}
                                    </div>
                                ` : ''}
                            </div>
                        </div>

                        <div class="paper-content-grid">
                            <div id="file-list-${paperId}" class="file-scroll-area border">
                                <div class="p-4 text-center text-muted small">กำลังโหลดรายการไฟล์...</div>
                            </div>
                            
                            <div>
                                ${(paperDate.getTime() >= today.getTime() || isExamPassed) ? `
                                    <div class="custom-drop-zone" id="drop-zone-${paperId}" onclick="document.getElementById('file-input-${paperId}').click()">
                                        <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                        <p class="small text-muted mb-0">คลิกหรือลากไฟล์มาที่นี่</p>
                                        <input type="file" id="file-input-${paperId}" class="d-none" multiple onchange="handleUpload('${paperId}', ${paperDate.getTime()}, this.files, ${isExamPassed})">
                                    </div>
                                ` : `
                                    <div class="custom-drop-zone border-0 bg-light text-muted" style="cursor: default;">
                                        <i class="fas fa-lock mb-2"></i>
                                        <span class="small">ปิดการส่งเอกสาร (หมดเขตแล้ว)</span>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                </div>`;
                }
            });

            const teacherHeader = teacherCards ? `
                <div class="task-grade-header mb-3" style="cursor: pointer;" data-toggle="collapse" data-target="#collapseGrade">
                    <div class="d-flex justify-content-between align-items-center bg-white p-3 shadow-sm" style="border-radius: 12px; border-left: 4px solid #4e73df;">
                        <h5 class="text-primary font-weight-bold mb-0">
                            <i class="fas fa-edit mr-2"></i> รายการที่ต้องลงคะแนน 
                            <span class="badge badge-danger ml-2">${teacherCount}</span>
                        </h5>
                        <i class="fas fa-chevron-down text-primary"></i>
                    </div>
                </div>
            ` : "";

            // สำหรับอาจารย์ ถ้ามีรายการที่ต้องลงคะแนน ให้พับ (collapse) รายการเอกสารเก็บไว้ก่อน เพื่อไม่ให้รก
            let docCollapseClass = (currentRole !== 'user' && teacherCards !== '') ? '' : 'show';
            let docTriggerClass = docCollapseClass === 'show' ? '' : 'collapsed';

            const studentHeader = studentCards ? `
                <div class="task-doc-header ${docTriggerClass} mb-3 mt-4" style="cursor: pointer;" data-toggle="collapse" data-target="#collapseDoc">
                    <div class="d-flex justify-content-between align-items-center bg-white p-3 shadow-sm" style="border-radius: 12px; border-left: 4px solid #858796;">
                        <h5 class="text-gray-800 font-weight-bold mb-0">
                            <i class="fas fa-file-alt mr-2"></i> รายการเอกสารและแบบฟอร์ม 
                            <span class="badge badge-secondary ml-2">${studentCount}</span>
                        </h5>
                        <i class="fas fa-chevron-down text-gray-800"></i>
                    </div>
                </div>
            ` : "";

            // นำการ์ดทั้งหมดมาจัดให้อยู่ใน Container ของ Grid ที่สามารถพับเก็บได้
            container.innerHTML = 
                (teacherCards ? `${teacherHeader}<div class="collapse show" id="collapseGrade"><div class="paper-grid">${teacherCards}</div></div>` : "") + 
                (studentCards ? `${studentHeader}<div class="collapse ${docCollapseClass}" id="collapseDoc"><div class="paper-grid">${studentCards}</div></div>` : "");

            // เริ่มต้นฟังก์ชันหลัง Render
            papers.forEach(p => {
                const paperDate = new Date(p.date);
                paperDate.setHours(0,0,0,0);
                const exactNow = new Date();
                const examPaper = papers.find(ex => ex.groupId === p.groupId && ex.passTimes === p.passTimes && isExamPaper(ex.mention));
                const isExamPassed = examPaper && exactNow.getTime() > new Date(examPaper.date).getTime();
                const isExam = isExamPaper(p.mention);

                initDragAndDrop(p._id, paperDate.getTime(), isExamPassed);
                fetchFileList(p._id, paperDate.getTime(), isExamPassed, isExam);
            });

        } catch (err) { console.error(err); }
    }

    // ✅ เพิ่มฟังก์ชัน Logic ทั้งหมด
    async function fetchFileList(paperId, paperDate, isExamPassed = false, isExam = false) {
        const listContainer = document.getElementById(`file-list-${paperId}`);
        if (!listContainer) return;
        try {
            
            const res = await fetch(`/api/getPaperFiles/${paperId}`);
            const files = await res.json();
            
            if (!files || files.length === 0) {
                listContainer.innerHTML = '<div class="p-4 text-center text-muted small">ไม่มีไฟล์</div>';
                return;
            }

            // ✅ ต้องเข้าถึงผ่าน f.file เพราะ Backend บันทึกแบบ Nested Object
            listContainer.innerHTML = files.map(f => {
                const isPDF = f.file && f.file.contentType === 'application/pdf';
                const fileId = f.file ? f.file.fileId : '';
                const filename = f.file ? f.file.filename : 'Unknown';
                const statusSpan = document.getElementById(`status-text-${paperId}`);

                const today = new Date();
                today.setHours(0,0,0,0);
                const pd = new Date(Number(paperDate));
                const date = (pd >= today || isExamPassed) && !statusSpan?.textContent.includes('พร้อมสอบแล้ว') && !isExam
                    ? `<div class="btn btn-danger btn-circle btn-sm shadow ml-auto" onclick="deleteFile('${fileId}', ${pd.getTime()}, ${isExamPassed})">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                        <a href="/file/download/${fileId}" class="btn btn-success btn-circle btn-sm shadow ml-auto">
                            <i class="fas fa-download"></i>
                        </a>`
                    : `<a href="/file/download/${fileId}" class="btn btn-success btn-circle btn-sm shadow ml-auto">
                            <i class="fas fa-download"></i>
                        </a>`;


                // ส่วนของชื่อไฟล์ (ถ้าเป็น PDF ให้มี Link)
                const fileContent = isPDF 
                    ? `<a href="/image/${fileId}" target="_blank" class="text-decoration-none d-flex align-items-center">
                        <span class="small text-truncate mr-2" style="max-width: 180px;"><i class="fas fa-file-pdf text-danger mr-2"></i>${filename}</span>
                    </a>`
                    : `<span class="small text-truncate mr-2" style="max-width: 180px;"><i class="fas fa-file-alt text-secondary mr-2"></i>${filename}</span>`;

                return `
                    <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                        <div style="min-width: 0; flex: 1;">
                            ${fileContent}
                        </div>
                        <div class="d-flex align-items-center justify-content-end" style="gap: 10px;">
                            ${date}
                        </div>
                    </div>
                `;
            }).join('');
        } catch (err) { console.error(err); }
    }

    window.handleUpload = async function(paperId, paperDate, files, isExamPassed = false) {
        if (!files.length) return;
        const formData = new FormData();
        for (let f of files) formData.append('files', f);

        // เริ่มแสดงสถานะกำลังโหลด
        Swal.fire({ title: 'กำลังอัปโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        try {
            // 1. เปลี่ยนไปเรียก API ใหม่ที่ไม่มี Logic แชทมาเกี่ยว
            const uploadRes = await fetch(`/api/paper/upload-raw`, { 
                method: 'POST', 
                body: formData 
            });
            
            if (!uploadRes.ok) {
                let errorMsg = `เกิดข้อผิดพลาดในการอัปโหลด (รหัส: ${uploadRes.status})`;
                const textData = await uploadRes.text().catch(() => '');
                try {
                    const errData = JSON.parse(textData);
                    errorMsg = errData.error || errData.message || errorMsg;
                } catch (e) {
                    if (uploadRes.status === 413 || textData.toLowerCase().includes('too large')) {
                        errorMsg = 'ขนาดไฟล์ใหญ่เกินกว่าที่ระบบรองรับ';
                    } else if (textData) {
                        errorMsg += `\nรายละเอียด: ${textData.replace(/<[^>]*>?/gm, '').substring(0, 100)}...`;
                    }
                }
                if (typeof errorMsg === 'string' && errorMsg.toLowerCase().includes('large')) {
                    errorMsg = 'ขนาดไฟล์ใหญ่เกินกว่าที่ระบบรองรับ';
                }
                throw new Error(errorMsg);
            }
            const uploadedData = await uploadRes.json();

            // 2. แมปข้อมูลให้ตรงกับที่ /api/PaperUploadFile ต้องการ (id และ filename)
            const filesData = uploadedData.map(m => ({ 
                id: m.fileId, 
                filename: m.filename,
                contentType: m.contentType
            }));

            // 3. ส่งไปบันทึก Metadata และอัปเดตสถานะกลุ่ม
            const saveRes = await fetch('/api/PaperUploadFile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paperId, filesData })
            });

            if (saveRes.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ',
                    text: 'อัปโหลดไฟล์เรียบร้อยแล้ว',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                throw new Error('Save metadata failed');
            }
        } catch (err) { 
            console.error("❌ Detail:", err);
            Swal.fire('ผิดพลาด', 'ไม่สามารถบันทึกไฟล์ได้: ' + err.message, 'error'); 
        }
    }

    function initDragAndDrop(paperId, paperDate, isExamPassed = false) {
        const zone = document.getElementById(`drop-zone-${paperId}`);
        if (!zone) return;
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eName => {
            zone.addEventListener(eName, e => { e.preventDefault(); e.stopPropagation(); }, false);
        });
        zone.addEventListener('drop', e => handleUpload(paperId, paperDate, e.dataTransfer.files, isExamPassed));
    }

    // ✅ ฟังก์ชันอัปเดตสถานะพร้อมสอบ (สำหรับอาจารย์ที่ปรึกษา)
    window.updateReadyStatus = async function(isReadyState, groupId, paperId, paperDate) {
        let isReady = isReadyState;
        let comment = "";

        if (isReady) {
            const confirm = await Swal.fire({
                title: 'ยืนยันความพร้อมสอบ?',
                text: "คุณต้องการยืนยันว่ากลุ่มนี้พร้อมสำหรับการสอบใช่หรือไม่?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก'
            });

            if (confirm.isConfirmed) {
                // ไปต่อ (isReady = true)
            } else {
                location.reload();
                return;
            }
        }

        if (!isReady) {
            const { value: text, isConfirmed: isTextConfirmed } = await Swal.fire({
                title: 'เหตุผลที่ไม่พร้อมสอบ',
                input: 'textarea',
                inputLabel: 'ระบุสิ่งที่นักศึกษาต้องแก้ไข (ข้อความนี้จะถูกส่งไปยังแชทกลุ่ม)',
                inputPlaceholder: 'กรอกข้อความที่นี่...',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                inputValidator: (value) => !value && 'กรุณาระบุเหตุผล!'
            });

            if (!isTextConfirmed) {
                location.reload();
                return;
            }
            comment = text;
        }

        try {
            const res = await fetch('/api/groups/mark-ready-for-exam', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ groupId, paperId, isReady, comment })
            });
            if (res.ok) {
                Swal.fire('สำเร็จ', `อัปเดตสถานะเป็น "${isReady ? 'พร้อมสอบ' : 'ไม่พร้อมสอบ'}" แล้ว`, 'success').then(() => location.reload());
            } else {
                const data = await res.json();
                throw new Error(data.error || 'ไม่สามารถอัปเดตได้');
            }
        } catch (err) {
            Swal.fire('ผิดพลาด', err.message, 'error').then(() => location.reload());
        }
    }

    window.showComment = (pId) => {
        const fixChecked = document.getElementById(`fix-${pId}`).checked;
        document.getElementById(`comment-${pId}`).classList.toggle('d-none', !fixChecked);
    }

    window.submitResult = async function(paperId) {
        const selected = document.querySelector(`input[name="choice-${paperId}"]:checked`)?.value;
        const comment = document.getElementById(`comment-${paperId}`).value;
        if (!selected) return Swal.fire('แจ้งเตือน', 'กรุณาเลือกผลการสอบ', 'warning');

        const confirm = await Swal.fire({ title: 'ยืนยัน?', text: `บันทึกผล: ${selected}`, icon: 'question', showCancelButton: true });
        if (confirm.isConfirmed) {
            const res = await fetch('/api/submitPaperResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paperId, result: selected, comment })
            });
            if ((await res.json()).success) {
                Swal.fire('สำเร็จ', 'บันทึกเรียบร้อย', 'success').then(() => location.reload());
            }
        }
    }

    window.deleteFile = async function(fileId, paperDate, isExamPassed = false) {
        const confirm = await Swal.fire({
            title: 'ยืนยันการลบ?',
            text: "ไฟล์นี้จะถูกลบออกจากระบบและไม่สามารถกู้คืนได้",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก'
        });

        if (confirm.isConfirmed) {
            Swal.fire({ title: 'กำลังลบ...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            try {
                const res = await fetch(`/api/PaperFile/delete`, { method: 'DELETE'  ,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fileId })
                });
                const result = await res.json(); 

                if (res.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'ไฟล์ถูกลบแล้ว',
                        showConfirmButton: false,
                        timer: 1000
                    }).then(() => location.reload()); // ✅ รีโหลดหน้าใหม่เพื่อให้ข้อมูลอัปเดตทั้งหมด
                } else {
                    throw new Error(result.error || 'ไม่สามารถลบไฟล์ได้');
                }
            } catch (err) {
                Swal.fire('ผิดพลาด', err.message, 'error');
            }
        }
    }

    document.addEventListener("DOMContentLoaded", loadPaperPlatforms);
</script>
