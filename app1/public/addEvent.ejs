    saveEventBtn.addEventListener("click", () => {
        const eventDateVal = document.getElementById("eventDate").value;
        const groupOnly = document.getElementById("groupOnlyCheckbox").checked;

        if (groupOnly && !chosenGroup) {
            Swal.fire({
                icon: 'warning',
                title: 'ข้อมูลไม่ครบถ้วน',
                text: 'กรุณาเลือกกลุ่มสำหรับกิจกรรมเฉพาะกลุ่ม',
                confirmButtonText: 'ตกลง'
            });
            return;
        }

        if (!selectedValue || selectedValue === "เลือกกิจกรรม"  || (selectedValue !== "วันสอบ" && !eventDateVal)) {
            Swal.fire({
                icon: 'warning',
                title: 'ข้อมูลไม่ครบถ้วน',
                text: 'กรุณาเลือกกิจกรรมและวันที่ให้ครบถ้วนก่อนบันทึก',
                confirmButtonText: 'ตกลง'
            });
            return;
        }

        // ตั้งค่า Description อัตโนมัติ
        const Name = eventName.value.trim();
        let desc = eventDescription.value.trim();
        if (selectedValue === "วันสอบ") desc = "จะมีการจัดสอบในวันที่กำหนด โปรดเตรียมเอกสารในการสอบให้เรียบร้อย";
        else if (selectedValue === "วันส่งเอกสาร") desc = "โปรดส่งเอกสารภายในวันที่กำหนด";
        else if (selectedValue === "อื่นๆ" && !desc && !eventName.value.trim()) {
            Swal.fire({
                icon: 'warning',
                title: 'ข้อมูลไม่ครบถ้วน',
                text: 'กรุณากรอกชื่อและรายละเอียดกิจกรรมสำหรับกิจกรรมอื่นๆ',
                confirmButtonText: 'ตกลง'
            });
            return;
        }
        // 1. ใช้ FormData แทน JSON ปกติเพื่อส่งไฟล์
        const formData = new FormData();
        formData.append("title", Name || selectedValue);
        formData.append("description", desc);
        formData.append("date", eventDateVal);
        if(groupOnly) formData.append("chosenGroup", chosenGroup);

        let link = (groupOnly && selectedValue !== "วันสอบ") ? '/api/addEventForGroup' : '/api/addEvent';

        if (selectedValue === "วันสอบ") {
            let examData = []; // ก้อนข้อมูลหลัก
            const dayContainers = document.querySelectorAll('.day-container');

            if (dayContainers.length === 0) {
                Swal.fire({ icon: 'warning', title: 'ไม่พบตารางสอบ', text: "กรุณาสร้างตารางสอบก่อนบันทึก" });
                return;
            }

            let hasError = false;

            dayContainers.forEach(dayCard => {
                const dateString = dayCard.dataset.date;
                const groupItems = dayCard.querySelectorAll('.group-item');
                
                let details = [];
                groupItems.forEach(groupEl => {
                    const groupId = groupEl.dataset.id;
                    const timeValue = groupEl.querySelector('.time-select').value;
                    const d1 = groupEl.querySelector('.adv-select').value;
                    const d2 = groupEl.querySelector('.dir2-select').value;
                    const d3 = groupEl.querySelector('.dir3-select').value;

                    if (!timeValue || !d1 || !d2 || !d3) {
                        hasError = true;
                    }

                    details.push({
                        group: groupId,
                        time: timeValue,
                        advisor: d1,
                        greatDirector: d2,
                        director: d3
                    });
                });

                if (details.length > 0) {
                    examData.push({
                        date: dateString,
                        slots: details
                    });
                }
            });

            const unassignedCount = document.getElementById('unassigned-groups').children.length;

            if (hasError) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ข้อมูลไม่ครบถ้วน',
                    text: "กรุณาระบุเวลาและกรรมการให้ครบทุกกลุ่มที่ถูกจัดลงตาราง",
                    confirmButtonText: 'ตกลง'
                });
                return;
            }

            if (examData.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ตารางว่างเปล่า',
                    text: "กรุณาลากกลุ่มลงในตารางอย่างน้อย 1 กลุ่ม",
                    confirmButtonText: 'ตกลง'
                });
                return;
            }

            if (unassignedCount > 0) {
                return Swal.fire({
                    title: 'มีกลุ่มที่ยังไม่ถูกจัดตาราง',
                    text: `เหลืออีก ${unassignedCount} กลุ่ม คุณต้องการบันทึกเพียงเท่านี้ใช่หรือไม่?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'บันทึกเลย',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        formData.append("examSchedule", JSON.stringify(examData));
                        executeSave(link, formData);
                    }
                });
            }

            formData.append("examSchedule", JSON.stringify(examData));
        }

        executeSave(link, formData);
    });

    function executeSave(link, formData) {
        saveEventBtn.disabled = true;
        saveEventBtn.innerText = "กำลังบันทึก...";

        Swal.fire({
            title: 'กำลังบันทึกกิจกรรม...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        fetch(link, {
            method: 'POST',
            body: formData 
        })
        .then(async response => {
            const result = await response.json();
            if (response.ok) {
                if (result.missingGroups && result.missingGroups.length > 0) {
                    Swal.close();
                    Swal.fire({
                        icon: 'warning',
                        title: 'บันทึกสำเร็จ (แต่ข้อมูลไม่ครบ)',
                        html: `${result.warning}<br><br><b class="text-danger">${result.missingGroups.join(', ')}</b><br><br>กลุ่มเหล่านี้ยังไม่พร้อมสอบ`,
                        confirmButtonText: 'รับทราบ'
                    }).then(() => window.location.href = "/event");
                } else {
                    Swal.close();
                    Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ',
                        confirmButtonText: 'ตกลง'
                    }).then(() => window.location.href = "/event");
                }
            } else {
                const errorMsg = result.message || result.error || "เกิดข้อผิดพลาดที่ไม่ทราบสาเหตุ";
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'บันทึกกิจกรรมไม่สำเร็จ',
                    text: errorMsg,
                    confirmButtonText: 'ตกลง'
                });
                saveEventBtn.disabled = false;
                saveEventBtn.innerText = "บันทึกกิจกรรม";
            }
        })
    }

