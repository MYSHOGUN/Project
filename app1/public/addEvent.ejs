    function initSortable() {
        const unassigned = document.getElementById('unassigned-groups');
        const dayLists = document.querySelectorAll('.day-slot-list');
        
        const sortableOptions = {
            group: 'shared',
            animation: 150,
            ghostClass: 'sortable-ghost',
            onEnd: function (evt) {
                // ✅ ฟังก์ชันสำหรับอัปเดตเวลาในแต่ละช่องโดยอัตโนมัติ
                const updateTimesInList = (listElement) => {
                    // ทำงานเฉพาะกับกล่องของวัน (day-slot-list)
                    if (listElement && listElement.classList.contains('day-slot-list')) {
                        const items = listElement.querySelectorAll('.group-item');
                        items.forEach((item, index) => {
                            const timeSelect = item.querySelector('.time-select');
                            if (timeSelect) {
                                // เริ่ม 8:00 (480 นาที) และบวกไปทีละ 1 ชั่วโมง (60 นาที)
                                const timeInMinutes = 480 + (index * 60);
                                timeSelect.value = timeInMinutes;
                            }
                        });
                    }
                };

                updateTimesInList(evt.to); // อัปเดตลิสต์ปลายทาง
                if (evt.from !== evt.to) updateTimesInList(evt.from); // อัปเดตลิสต์ต้นทาง (ถ้ามีการย้ายข้าม)

                updateCounts();
            }
        };

        new Sortable(unassigned, sortableOptions);
        dayLists.forEach(list => {
            new Sortable(list, sortableOptions);
        });
    }

    function updateCounts() {
        const unassignedCount = document.getElementById('unassigned-groups').children.length;
        document.getElementById('unassigned-count').innerText = unassignedCount;
        
        document.querySelectorAll('.day-container').forEach(day => {
            const count = day.querySelector('.day-slot-list').children.length;
            day.querySelector('.badge-counter').innerText = count + ' กลุ่ม';
        });
    }

    function handleTeacherChange(selectElement) {
        const groupItem = selectElement.closest('.group-item');
        const selects = groupItem.querySelectorAll('.adv-select, .dir2-select, .dir3-select');
        
        const values = Array.from(selects).map(s => s.value);
        const hasDuplicate = values.some((val, i) => val !== "" && values.indexOf(val) !== i);
        
        if (hasDuplicate) {
            Swal.fire({
                icon: 'warning',
                title: 'เลือกอาจารย์ซ้ำ',
                text: 'กรุณาเลือกอาจารย์ที่ไม่ซ้ำกันในกลุ่มเดียวกัน',
                timer: 2000,
                showConfirmButton: false
            });
            selectElement.value = ""; 
        }
        
        updateWorkloadUI();
    }
    
    function updateMinDate() {
        const today = new Date().toISOString().split('T')[0];
        
        const eventDate = document.getElementById("eventDate");
        if (eventDate && eventDate._flatpickr) eventDate._flatpickr.set('minDate', today);
        
        const startEventDate = document.getElementById("start-eventDate");
        if (startEventDate && startEventDate._flatpickr) {
            startEventDate._flatpickr.set('minDate', today);
        }

        if (selectedValue === "วันสอบ") {
            for (let i = 1; i <= sectionCount; i++) {
                const el = document.getElementById("start-eventDate" + i);
                if (el && el._flatpickr) {
                    // หาช่องกรอกวันที่ของชุดก่อนหน้าเพื่อตั้งค่า min
                    const prevId = i === 1 ? "start-eventDate" : "start-eventDate" + (i - 1);
                    const prevEl = document.getElementById(prevId);
                    
                    if (prevEl && prevEl.value) {
                        el._flatpickr.set('minDate', prevEl.value);
                        // หากวันที่ที่เคยเลือกไว้น้อยกว่าเงื่อนไข ให้เคลียร์ค่าทิ้ง
                        if (el.value && el.value < prevEl.value) {
                            el._flatpickr.clear();
                        }
                    } else {
                        el._flatpickr.set('minDate', today);
                    }
                }
            }
        }
    }

    function initializeFlatpickr(selector) {
        flatpickr(selector, {
            locale: "th",
            dateFormat: "Y-m-d",
            minDate: "today",
            disableMobile: true, // ใช้ปฏิทินของ Flatpickr บนมือถือแทน
            onChange: function() {
                updateMinDate();
            }
        });
    }

    function initDatePicker() {
        initializeFlatpickr("#eventDate");
        initializeFlatpickr("#examStartDate");
        initializeFlatpickr("#start-eventDate");
        updateMinDate();
    }

