<style>
    /* View Profile Page Styling */
    .view-profile-card {
        width: 100% !important;
        max-width: 800px !important;
        margin: 0 auto;
        border: none; 
        border-radius: 20px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        overflow: hidden; 
        background: white;
    }

    .view-profile-header-bg {
        height: 150px; 
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    }

    .view-avatar-wrapper {
        margin-top: -75px; 
        position: relative; 
        display: inline-block;
    }

    .view-avatar-img {
        width: 150px; 
        height: 150px; 
        object-fit: cover;
        border-radius: 50%; 
        border: 5px solid white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        background: #f8f9fc;
    }

    .info-label {
        font-size: 0.85rem;
        color: #858796;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 1.15rem;
        color: #3a3b45;
        font-weight: 500;
        margin-bottom: 2rem;
        border-bottom: 2px solid #f1f3f9;
        padding-bottom: 12px;
    }

    /* บังคับตัดคำ 100% ป้องกัน Flexbox ดื้อ */
    .info-value-truncate {
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        display: block !important;
        max-width: 100% !important;
    }

    /* จัด Layout ด้วย CSS Grid */
    .profile-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem 2rem;
    }
    @media (max-width: 768px) {
        .profile-info-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .project-history-card {
        background: #fdfdfd;
        border: 1px solid #eaecf4;
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .project-history-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
</style>

<div class="container-fluid py-4" style="min-height: 84vh; background: #f4f7f6;">
    
    <button onclick="window.history.back()" class="btn btn-light rounded-pill shadow-sm font-weight-bold text-gray-700 mb-4 ml-3" style="width: fit-content;">
        <i class="fas fa-arrow-left mr-2"></i> ย้อนกลับ
    </button>

    <div class="row justify-content-center align-items-center">
        <div class="col-lg-12">
            <div class="card view-profile-card">
                <div class="view-profile-header-bg"></div>
                <div class="card-body text-center px-4 pb-5">
                    <div class="view-avatar-wrapper">
                        <% if (viewUser.picture && viewUser.picture !== "null" && viewUser.picture !== "") { %>
                            <img src="/image/<%= viewUser.picture.id ? viewUser.picture.id : viewUser.picture %>" class="view-avatar-img" alt="Profile" onerror="this.src='/img/undraw_profile.svg'">
                        <% } else { %>
                            <img src="/img/undraw_profile.svg" class="view-avatar-img" alt="Default Profile">
                        <% } %>
                    </div>
                    
                    <h2 class="mt-3 font-weight-bold text-gray-800"><%= viewUser.name %> <%= viewUser.lastname %></h2>
                    <span class="badge badge-primary px-4 py-2 rounded-pill mt-2 shadow-sm" style="font-size: 0.95rem;">
                        <i class="fas fa-id-card mr-2"></i>
                        <% if (viewUser.role === 'teacher') { %> รหัสอาจารย์ <% } else { %> รหัสนักศึกษา <% } %>: <%= viewUser.username %>
                    </span>

                    <div class="profile-info-grid text-left mt-5 px-lg-5">
                        <div>
                            <div class="info-label"><i class="fas fa-envelope mr-2 text-primary"></i>อีเมล</div>
                            <div class="info-value info-value-truncate" style="min-height: 42px; padding-top: 6px;" title="<%= viewUser.email || '-' %>">
                                <%= viewUser.email || '-' %>
                            </div>
                        </div>
                        <div>
                            <div class="info-label"><i class="fas fa-phone mr-2 text-primary"></i>เบอร์โทรศัพท์</div>
                            <div class="info-value info-value-truncate" style="min-height: 42px; padding-top: 6px;" title="<%= viewUser.phone || '-' %>">
                                <%= viewUser.phone || '-' %>
                            </div>
                        </div>
                        
                        <% if (viewUser.role !== 'teacher' && viewUser.role !== 'admin') { %>
                        <div>
                            <div class="info-label"><i class="fas fa-graduation-cap mr-2 text-primary"></i>สาขาวิชา</div>
                            <div class="info-value info-value-truncate" style="min-height: 42px; padding-top: 6px;" title="<%= viewUser.branch || 'EnET' %>">
                                <%= viewUser.branch || 'EnET' %>
                            </div>
                        </div>
                        <div>
                            <div class="info-label"><i class="fas fa-info-circle mr-2 text-primary"></i>สถานะโครงงาน</div>
                            <div class="info-value d-flex align-items-center" style="min-height: 42px;">
                                <% 
                                let badgeClass = "badge-primary";
                                if (viewUser.displayStatus === "ไม่มีกลุ่ม" || !viewUser.displayStatus) badgeClass = "badge-secondary";
                                else if (viewUser.displayStatus.includes("ผ่าน") || viewUser.displayStatus.includes("สำเร็จ") || viewUser.displayStatus.includes("จบแล้ว")) badgeClass = "badge-success";
                                else if (viewUser.displayStatus.includes("ไม่ผ่าน")) badgeClass = "badge-danger";
                                else if (viewUser.displayStatus.includes("รอ") || viewUser.displayStatus.includes("พร้อม")) badgeClass = "badge-warning text-dark";
                                %>
                                <span class="badge <%= badgeClass %> px-3 py-2 shadow-sm"><%= viewUser.displayStatus || 'ไม่มีข้อมูล' %></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if ((typeof currentGroup !== 'undefined' && currentGroup) || (typeof pastGroups !== 'undefined' && pastGroups.length > 0)) { %>
                <div class="card view-profile-card mt-4 mb-4">
                    <div class="card-body px-4 py-4 px-lg-5">
                        <h5 class="font-weight-bold text-primary mb-4 border-left-primary pl-3" style="border-left-width: 4px !important;">ข้อมูลกลุ่มปริญญานิพนธ์</h5>
                        
                        <div class="row">
                            <% if (typeof currentGroup !== 'undefined' && currentGroup) { %>
                                <div class="col-12 mb-4">
                                    <div class="info-label mb-2"><i class="fas fa-users mr-2 text-success"></i>กลุ่มปัจจุบัน</div>
                                    <div class="project-history-card p-3 border-left-success" style="border-left-width: 4px !important;">
                                        <div class="font-weight-bold text-dark h6 mb-1"><%= currentGroup.projectName %></div>
                                        <div class="small text-muted mb-2"><%= currentGroup.engName || '-' %></div>
                                        <div>
                                            <% 
                                            let badgeClass = "badge-primary";
                                            if (currentGroup.status.includes("ผ่าน") || currentGroup.status.includes("สำเร็จ") || currentGroup.status.includes("จบแล้ว")) badgeClass = "badge-success";
                                            else if (currentGroup.status.includes("ไม่ผ่าน")) badgeClass = "badge-danger";
                                            else if (currentGroup.status.includes("รอ") || currentGroup.status.includes("พร้อม")) badgeClass = "badge-warning text-dark";
                                            %>
                                            <span class="badge <%= badgeClass %> px-2 py-1 shadow-sm"><%= currentGroup.status %></span>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <% if (typeof pastGroups !== 'undefined' && pastGroups.length > 0) { %>
                                <div class="col-12">
                                    <div class="info-label mb-2"><i class="fas fa-history mr-2 text-secondary"></i>ประวัติที่เคยเข้าร่วม</div>
                                    <div class="d-flex flex-column" style="gap: 12px;">
                                        <% pastGroups.forEach(g => { %>
                                            <div class="project-history-card p-3 border-left-secondary" style="border-left-width: 4px !important;">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="font-weight-bold text-gray-800 h6 mb-1"><%= g.projectName %></div>
                                                        <div class="small text-muted mb-2"><%= g.engName || '-' %></div>
                                                    </div>
                                                    <span class="badge badge-secondary px-2 py-1 shadow-sm">สิ้นสุดสถานภาพ</span>
                                                </div>
                                                <hr class="my-2">
                                                <div class="small text-muted">
                                                    <!-- สมมติว่า Backend ส่งข้อมูล joinedAt และ leftAt มาใน object ของ g -->
                                                    <i class="fas fa-calendar-plus mr-1 text-success"></i> เข้าร่วมเมื่อ: <%= g.joinedAt ? new Date(g.joinedAt).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) : '-' %> <br>
                                                    <i class="fas fa-calendar-times mr-1 text-danger mt-1"></i> ออกจากกลุ่มเมื่อ: <%= g.leftAt ? new Date(g.leftAt).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) : '-' %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>