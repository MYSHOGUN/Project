<style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;700&display=swap');

    /* จัด Layout ให้กึ่งกลางและสมบูรณ์ */
    .event-detail-wrapper {
        font-family: 'Prompt', sans-serif !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        min-height: 85vh !important;
        width: 100% !important;
        padding: 2rem 0 !important;
    }

    .event-card {
        width: 100% !important;
        max-width: 1150px !important;
        background: #ffffff !important;
        border-radius: 20px !important;
        box-shadow: 0 12px 35px rgba(0,0,0,0.1) !important;
        border: none !important;
    }

    .event-header {
        background: linear-gradient(135deg, #f8f9fc 0%, #ffffff 100%) !important;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        padding: 2.5rem !important;
        border-bottom: 2px solid #e3e6f0 !important;
    }

    .table-responsive {
        border-radius: 12px !important;
        border: 1px solid #dee2e6 !important;
        overflow-x: auto !important; /* เปลี่ยนเพื่อให้เลื่อนซ้ายขวาได้ */
    }

    .table th {
        white-space: nowrap; /* ป้องกันหัวตารางหดตัว เพื่อบังคับให้เกิดการ Scroll */
    }

    .table thead {
        background: linear-gradient(90deg, #4e73df 0%, #224abe 100%) !important;
        color: white !important;
        border-bottom: 0 !important;
    }

    .excel-section {
        margin-top: 2.5rem !important;
        padding-top: 2rem !important;
        border-top: 2px dashed #eaecf4 !important;
    }

    /* Input styles for editable table */
    .editable-input {
        background: transparent;
        transition: all 0.2s ease;
        border-radius: 6px;
    }
    .editable-input:focus {
        background: #fff !important;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25) !important;
        border-color: #bac8f3 !important;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fc !important;
    }
    .btn-rounded {
        border-radius: 50px !important;
    }
</style>

<div class="container-fluid">
    <div class="event-detail-wrapper">
        
        <div class="d-flex align-items-center justify-content-between mb-4" style="width: 100%; max-width: 1150px;">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
                <i class="fas fa-calendar-alt mr-2 text-primary"></i>รายละเอียดกิจกรรม
            </h1>
            <% if (user && user.role === 'admin') { %>
                <button class="btn btn-danger shadow-sm px-4 btn-rounded" onclick="deleteEvent()">
                    <i class="fas fa-trash-alt mr-2"></i> ลบตารางกิจกรรม
                </button>
            <% } %>
        </div>

        <div class="event-card">
            <div class="event-header text-center">
                <h2 class="text-primary font-weight-bold mb-2"><%= event.title %></h2>
                <% if (typeof groupName !== 'undefined' && groupName) { %>
                    <span class="badge badge-info px-3 py-2 rounded-pill mt-2 shadow-sm" style="font-size: 0.95rem; font-weight: 500;">
                        <i class="fas fa-users mr-2"></i>สำหรับเฉพาะกลุ่ม: <%= groupName %>
                    </span>
                <% } %>
                <!-- <p class="text-muted mb-0"><i class="fas fa-info-circle mr-1"></i> รายละเอียดกำหนดการสอบ</p> -->
            </div>
            
            <div class="event-body p-4 p-md-5">
                <div class="row mb-4" style="justify-content: space-evenly; align-items: center;">
                    <div class="col-md-8">
                        <label class="text-primary font-weight-bold small text-uppercase">รายละเอียด</label>
                        <p class="text-dark" style="font-size: 1.1rem;"><%= event.description || 'ไม่มีรายละเอียด' %></p>
                    </div>
                    <div class="col-md-4">
                        <label class="text-primary font-weight-bold small text-uppercase">วันที่</label>
                        <p class="h5 font-weight-bold text-gray-800">
                            <%= event.date ? new Date(event.date).toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric', calendar: 'buddhist' }) : 'ไม่ระระบุ' %>
                        </p>
                    </div>
                </div>

                <% if (typeof tableData !== 'undefined' && tableData && tableData.length > 0) { %>
                    <div class="excel-section mt-5 pt-4 border-top">
                        <div class="text-center mb-4">
                            <h5 class="font-weight-bold text-dark mb-2">
                                <i class="fas fa-table mr-2 text-primary"></i>ตารางกำหนดการสอบ
                                <% if (user.role === 'admin') { %>
                                    <small class="text-muted d-block mt-2">(โหมดแก้ไขสำหรับผู้ดูแลระบบ)</small>
                                <% } %>
                            </h5>
                            <button type="button" class="btn btn-outline-success btn-sm btn-rounded shadow-sm mt-2" onclick="downloadTableAsExcel()">
                                <i class="fas fa-file-excel mr-1"></i> ดาวน์โหลดเป็น Excel
                            </button>
                        </div>
                        
                        <form id="scheduleForm">
                            <div class="table-responsive shadow-sm">
                                <table class="table table-bordered table-hover mb-0" id="editableTable">
                                    <thead class="bg-primary text-white text-center">
                                        <tr>
                                            <th style="width: 80px;">ลำดับ</th>
                                            <th>กลุ่ม</th>
                                            <th>วันที่</th>
                                            <th>เริ่มเวลา</th>
                                            <th>อาจารย์ที่ปรึกษา</th>
                                            <th>ประธานกรรมการ</th>
                                            <th>กรรมการสอบ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% tableData.forEach((row, index) => { %>
                                            <tr class="schedule-row">
                                                <% if (user.role === 'admin') { %>
                                                    <td class="p-1"><input type="text" name="data[<%= index %>][ลำดับ]" class="form-control border-0 text-center editable-input" value="<%= index+1 %>"></td>
                                                    <td class="p-1 font-weight-bold"><input type="text" name="data[<%= index %>][ชื่อกลุ่ม]" class="form-control border-0 editable-input" value="<%= row.groupName %>" data-toggle="tooltip" title="<%= row.groupName %>"></td>
                                                    <td class="p-0">
                                                        <input type="date" name="data[<%= index %>][dateOnly]" 
                                                            class="form-control border-0 text-center editable-input" 
                                                            value="<%= new Date(row.date).toISOString().split('T')[0] %>">
                                                    </td>
                                                    <td class="p-0">
                                                        <input type="time" name="data[<%= index %>][timeOnly]" 
                                                            class="form-control border-0 text-center font-weight-bold text-primary editable-input" 
                                                            value="<%= (d => String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'))(new Date(row.date)) %>">
                                                    </td>
                                                    <td class="p-1"><input type="text" name="data[<%= index %>][อาจารย์ที่ปรึกษา]" class="form-control border-0 editable-input small" value="<%= row.advisor || '' %>"></td>
                                                    <td class="p-1"><input type="text" name="data[<%= index %>][ประธานกรรมการ]" class="form-control border-0 editable-input small" value="<%= row.greatDirector || '' %>"></td>
                                                    <td class="p-1"><input type="text" name="data[<%= index %>][กรรมการ]" class="form-control border-0 editable-input small" value="<%= row.director || '' %>"></td>
                                                <% } else { %>
                                                    <td class="text-center text-muted"><%= index+1 %></td>
                                                    <td class="font-weight-bold text-gray-800" data-toggle="tooltip" title="<%= row.groupName %>"><%= row.groupName %></td>
                                                    <td class="text-center"><%= new Date(row.date).toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric', calendar: 'buddhist' }) || '-' %></td>
                                                    <td class="text-center font-weight-bold text-primary"><%= (d => String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'))(new Date(row.date)) %></td>
                                                    <td class="small"><%= row.advisor || '-' %></td>
                                                    <td class="small"><%= row.greatDirector || '-' %></td>
                                                    <td class="small"><%= row.director || '-' %></td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <% if (user.role === 'admin') { %>
                                <div class="text-right mt-3">
                                    <button type="button" id="saveScheduleBtn" class="btn btn-success shadow-sm btn-rounded px-4">
                                        <i class="fas fa-save mr-2"></i>บันทึกการแก้ไขทั้งหมด
                                    </button>
                                </div>
                            <% } %>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="mt-4">
            <a href="/event" class="btn btn-link text-muted font-weight-bold text-decoration-none">
                <i class="fas fa-chevron-left mr-2"></i>ย้อนกลับ
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script>
    // ✅ ฟังก์ชันสำหรับดาวน์โหลดตารางออกมาเป็นไฟล์ Excel
    function downloadTableAsExcel() {
        try {
            // 1. Safely get event title and create a valid filename.
            // This prevents errors if the title has special characters like quotes.
            const eventTitleRaw = JSON.stringify(event.title || "");
            const eventTitle = eventTitleRaw.replace(/[^a-zA-Z0-9\u0E00-\u0E7F\s]/g, '').replace(/\s+/g, '_');
            const fileName = `ตารางสอบ_${eventTitle}.xlsx`;

            // 2. Manually extract data into an array of arrays. This is the most stable method.
            const data = [];
            const table = document.getElementById('editableTable');
            if (!table) throw new Error("Table element not found.");

            // Extract headers
            const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent.trim());
            data.push(headers);

            // Extract body rows
            const bodyRows = table.querySelectorAll('tbody tr');
            bodyRows.forEach(tr => {
                const rowData = [];
                tr.querySelectorAll('td').forEach(td => {
                    const input = td.querySelector('input');
                    const cellValue = String(input ? input.value : td.textContent.trim());
                    rowData.push(cellValue);
                });
                data.push(rowData);
            });

            // 3. Create worksheet and workbook.
            const ws = XLSX.utils.aoa_to_sheet(data);

            // 4. (Optional but helpful) Auto-fit column widths.
            ws['!cols'] = headers.map((h, i) => ({
                wch: data.reduce((max, row) => Math.max(max, String(row[i] || '').length), h.length) + 1
            }));

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "ตารางสอบ");
            XLSX.writeFile(wb, fileName);

        } catch (error) {
            console.error("Excel download error:", error);
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถสร้างไฟล์ Excel ได้: ' + error.message, 'error');
        }
    }

    async function deleteEvent() {
        const result = await Swal.fire({
            title: 'ต้องการลบกิจกรรม?',
            text: "ข้อมูลกิจกรรมและตารางสอบจะถูกลบถาวร",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796',
            confirmButtonText: 'ลบเลย',
            cancelButtonText: 'ยกเลิก',
            reverseButtons: true
        });

        if (result.isConfirmed) {
            // 1. แสดงหน้าจอ Loading
            Swal.fire({ 
                title: 'กำลังลบ...', 
                allowOutsideClick: false, // ป้องกันการกดปิดขณะลบ
                didOpen: () => Swal.showLoading() 
            });

            try {
                const response = await fetch('/deleteEvent/<%= event.id %>', { method: 'DELETE' });
                
                // ตรวจสอบว่า response เป็น JSON หรือไม่
                const data = await response.json();

                if (response.ok && data.success) {
                    // 2. สำเร็จ
                    await Swal.fire({
                        title: 'สำเร็จ',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'ตกลง'
                    });
                    window.location.href = '/event';
                } else {
                    // 3. กรณี Server ตอบกลับมาว่าไม่สำเร็จ (เช่น หา ID ไม่เจอ)
                    Swal.fire('ผิดพลาด', data.message || 'ไม่สามารถลบข้อมูลได้', 'error');
                }

            } catch (error) {
                // 4. กรณี Network Error หรือ Server ล่ม
                console.error("Fetch Error:", error);
                Swal.fire('ผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้ หรือเกิดข้อผิดพลาดภายใน', 'error');
            }
        }
    }


    // ในหน้า eventInfo.ejs ส่วน <script>
    const saveBtn = document.getElementById("saveScheduleBtn");
    if (saveBtn) {
        saveBtn.addEventListener("click", async function() {
            // 1. แสดงหน้าต่างยืนยัน (Confirm Dialog)
            const confirmResult = await Swal.fire({
                title: 'ยืนยันการบันทึก?',
                text: "ข้อมูลในตารางจะถูกอัปเดตข้อมูลระบบทันที",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1cc88a',
                cancelButtonColor: '#858796',
                confirmButtonText: 'ใช่, บันทึกเลย',
                cancelButtonText: 'ยกเลิก',
                reverseButtons: true
            });

            // ถ้าผู้ใช้กด "ยกเลิก" ให้หยุดการทำงาน
            if (!confirmResult.isConfirmed) return;

            const originalHTML = this.innerHTML;
            const rows = document.querySelectorAll(".schedule-row");
            const scheduleData = [];

            // 2. รวบรวมข้อมูลจากตาราง
            rows.forEach((row) => {
                const inputs = row.querySelectorAll("input, textarea");
                const rowObj = {};
                inputs.forEach(input => {
                    const nameAttr = input.getAttribute("name");
                    // ดึง key เช่น [ชื่อกลุ่ม] จาก data[0][ชื่อกลุ่ม]
                    const keyMatch = nameAttr.match(/\[([^\]]+)\]$/); 
                    if (keyMatch) {
                        rowObj[keyMatch[1]] = input.value;
                    }
                });
                scheduleData.push(rowObj);
            });

            const payload = {
                eventId: "<%= event.id %>",
                data: scheduleData
            };

            // 3. เริ่มส่งข้อมูลไป Server
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>กำลังบันทึก...';

            try {
                const response = await fetch("/update-exam-schedule", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ',
                        text: 'ข้อมูลตารางสอบและไฟล์ Excel ถูกอัปเดตเรียบร้อยแล้ว',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    const errorText = await response.text();
                    throw new Error(errorText || "เซิร์ฟเวอร์ตอบกลับด้วยข้อผิดพลาด");
                }
            } catch (err) {
                console.error("❌ Save Error:", err);
                Swal.fire('เกิดข้อผิดพลาด', err.message, 'error');
                this.disabled = false;
                this.innerHTML = originalHTML;
            }
        });
    }

    // Initialise Tooltips
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>